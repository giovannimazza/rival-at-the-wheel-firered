diff --git a/include/battle_remote.h b/include/battle_remote.h
new file mode 100644
index 000000000..d68548edd
--- /dev/null
+++ b/include/battle_remote.h
@@ -0,0 +1,121 @@
+#ifndef GUARD_BATTLE_REMOTE_H
+#define GUARD_BATTLE_REMOTE_H
+
+// Remote Trainer: lets a second person (through an mGBA Lua script)
+// choose what the opposing trainer does in every trainer battle.
+// The game writes a request into gRemoteControl and waits; the script
+// writes the answer back. Layout must stay in sync with remote_trainer.lua.
+
+#define REMOTE_MAGIC        0x4C544352 // "RCTL"
+#define REMOTE_VERSION      1
+
+// Request types (game -> script)
+#define REMOTE_REQ_NONE       0
+#define REMOTE_REQ_ACTION     1 // move, item, switch or AI
+#define REMOTE_REQ_MOVE       2 // move or AI only
+#define REMOTE_REQ_SWITCH_IN  3 // replacement after faint: party slot or AI
+
+// Response types (script -> game)
+#define REMOTE_RESP_MOVE    1 // arg1 = move slot, arg2 = target battler
+#define REMOTE_RESP_ITEM    2 // arg1 = trainer item slot
+#define REMOTE_RESP_SWITCH  3 // arg1 = party slot
+#define REMOTE_RESP_AI      4 // let the normal AI decide
+
+// Error codes written to lastError when a response is rejected
+#define REMOTE_ERR_NONE          0
+#define REMOTE_ERR_BAD_TYPE      1
+#define REMOTE_ERR_BAD_MOVE      2
+#define REMOTE_ERR_MOVE_BLOCKED  3
+#define REMOTE_ERR_BAD_ITEM      4
+#define REMOTE_ERR_BAD_SWITCH    5
+#define REMOTE_ERR_TRAPPED       6
+
+// Poll results
+#define REMOTE_RESULT_WAIT   0
+#define REMOTE_RESULT_DONE   1
+#define REMOTE_RESULT_USE_AI 2
+
+struct RemoteBattlerInfo
+{
+    /*0x00*/ u16 species;
+    /*0x02*/ u16 hp;
+    /*0x04*/ u16 maxHP;
+    /*0x06*/ u16 item;
+    /*0x08*/ u32 status1;
+    /*0x0C*/ u32 status2;
+    /*0x10*/ u16 moves[4];
+    /*0x18*/ u8 pp[4];
+    /*0x1C*/ u8 maxPp[4];
+    /*0x20*/ s8 statStages[8];
+    /*0x28*/ u8 level;
+    /*0x29*/ u8 present;
+    /*0x2A*/ u8 type1;
+    /*0x2B*/ u8 type2;
+    /*0x2C*/ u8 ability;
+    /*0x2D*/ u8 partyIndex;
+    /*0x2E*/ u16 lastMove;
+    /*0x30*/ u8 nickname[12];
+    /*0x3C*/ u32 status3;
+}; // size 0x40
+
+struct RemoteMonInfo
+{
+    /*0x00*/ u16 species;
+    /*0x02*/ u16 hp;
+    /*0x04*/ u16 maxHP;
+    /*0x06*/ u16 heldItem;
+    /*0x08*/ u32 status;
+    /*0x0C*/ u16 moves[4];
+    /*0x14*/ u8 pp[4];
+    /*0x18*/ u8 level;
+    /*0x19*/ u8 flags; // bit0 exists, bit1 on field, bit2 can be sent in, bit3 egg
+    /*0x1A*/ u8 nickname[12];
+    /*0x26*/ u8 maxPp[4];
+    /*0x2A*/ u8 padding[2];
+}; // size 0x2C
+
+struct RemoteControl
+{
+    /*0x000*/ u32 magic;
+    /*0x004*/ u8 reqSeq;
+    /*0x005*/ u8 reqType;
+    /*0x006*/ u8 reqBattler;
+    /*0x007*/ u8 respSeq;
+    /*0x008*/ u8 respType;
+    /*0x009*/ u8 respArg1;
+    /*0x00A*/ u8 respArg2;
+    /*0x00B*/ u8 lastError;
+    /*0x00C*/ u32 battleTypeFlags;
+    /*0x010*/ u16 trainerId;
+    /*0x012*/ u8 battlersCount;
+    /*0x013*/ u8 inBattle;
+    /*0x014*/ u16 trainerItems[4];
+    /*0x01C*/ u8 trainerClassName[14];
+    /*0x02A*/ u8 trainerName[14];
+    /*0x038*/ u8 unusableMoves;
+    /*0x039*/ u8 canSwitch;
+    /*0x03A*/ u8 itemUsable;
+    /*0x03B*/ u8 switchableMons;
+    /*0x03C*/ u8 turn;
+    /*0x03D*/ u8 absentFlags;
+    /*0x03E*/ u16 weather;
+    /*0x040*/ u16 sideStatuses[2];
+    /*0x044*/ u32 version;
+    /*0x048*/ struct RemoteBattlerInfo battlers[4];
+    /*0x148*/ struct RemoteMonInfo party[6];
+    /*0x250*/ u8 playerPartyStatus[6]; // 0 none, 1 ok, 2 status problem, 3 fainted
+    /*0x256*/ u8 padding[2];
+}; // size 0x258
+
+extern struct RemoteControl gRemoteControl;
+extern const u8 gRemoteControlSignature[];
+
+bool8 RemoteControl_IsActive(void);
+void RemoteControl_InitBattler(u8 battler);
+void RemoteControl_EndBattle(void);
+void RemoteControl_BeginRequest(u8 battler, u8 type);
+u8 RemoteControl_Poll(u8 battler);
+bool8 RemoteControl_TakeAiTurn(u8 battler);
+bool8 RemoteControl_TakePendingMove(u8 battler);
+
+#endif // GUARD_BATTLE_REMOTE_H
